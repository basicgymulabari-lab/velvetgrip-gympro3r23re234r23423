SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Server-only billing secrets. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live
STRIPE_PRICE_ID=price_monthly_pro
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_ID=plan_monthly_pro
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_TOTAL_COUNT=120

# Public display text only; these are safe to expose in the client bundle.
VITE_PRO_PLAN_NAME=IRONVAULT Pro
VITE_PRO_PLAN_PRICE_LABEL=Monthly subscription

# Optional local subscription lifecycle controls. Leave false outside dedicated QA.
VITE_ENABLE_LOCAL_BILLING=false
